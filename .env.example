# MoneyBags settings. Copy to .env (command line) or enter these in Dockhand's stack environment variables.

# Port on the Docker host. Check it is free first: sudo ss -ltnp | grep ':8417 '
MONEYBAGS_PORT=8417

# Folder on the Docker host that holds accounts, the book and its daily backups. Must be owned by UID 65532.
MONEYBAGS_DATA_DIR=/opt/moneybags/data

# Time zone used for dates in the server log.
TZ=America/Los_Angeles

# on: the sign-in page offers "Create account". off: no new accounts.
MONEYBAGS_SIGNUP=on

# Most accounts allowed. Sign-up closes by itself once this many exist. 0 means no limit.
MONEYBAGS_MAX_USERS=2

# auto: the session cookie is marked secure when the request arrives over HTTPS (directly or through a
# Cloudflare Tunnel that sets X-Forwarded-Proto). always or never force it.
MONEYBAGS_SECURE_COOKIE=auto
